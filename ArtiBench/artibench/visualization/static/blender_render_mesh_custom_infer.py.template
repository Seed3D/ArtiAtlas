import glob
import json
import math
import os
from pathlib import Path

import bpy
import numpy as np
from mathutils import Vector

manifest_path = Path("{{MANIFEST_PATH}}")
state_path = Path("{{STATE_PATH}}")

resolution_x = {{RES_X}}
resolution_y = {{RES_Y}}
resolution_percentage = 100

fit_margin = float({{FIT_MARGIN}})
camera_r_override = {{CAMERA_R}}
camera_elevation = float({{CAMERA_ELEVATION}})
lens_mm = float({{LENS_MM}})
sensor_width_mm = float({{SENSOR_WIDTH_MM}})
target_z = float({{TARGET_Z}})


def spherical_to_cartesian(radius, azimuth_deg, elevation_deg):
    azimuth_rad = math.radians(azimuth_deg)
    elevation_rad = math.radians(elevation_deg)
    x = radius * math.cos(elevation_rad) * math.cos(azimuth_rad)
    y = radius * math.cos(elevation_rad) * math.sin(azimuth_rad)
    z = radius * math.sin(elevation_rad)
    return x, y, z


def clear_scene():
    try:
        bpy.ops.object.mode_set(mode="OBJECT")
    except Exception:
        pass
    bpy.ops.object.select_all(action="SELECT")
    bpy.ops.object.delete(use_global=False)


def split_fit_margin(value):
    margin = float(value)
    if margin <= 0.0:
        raise ValueError(f"fit_margin must be positive, got {value}")
    if margin <= 1.0:
        return margin, 1.0
    return 1.0, margin


def required_camera_radius_for_points(points_world, target_world, azimuth_deg, elevation_deg, occupancy):
    if occupancy <= 0.0 or occupancy > 1.0:
        raise ValueError(f"occupancy must be in (0, 1], got {occupancy}")

    pts = np.asarray(points_world, dtype=np.float64).reshape(-1, 3)
    tgt = np.asarray(target_world, dtype=np.float64).reshape(3)

    camera_dir = np.asarray(spherical_to_cartesian(1.0, azimuth_deg, elevation_deg), dtype=np.float64)
    camera_dir /= np.linalg.norm(camera_dir) + 1e-12

    forward = -camera_dir
    up_hint = np.array([0.0, 0.0, 1.0], dtype=np.float64)
    if abs(np.dot(forward, up_hint)) > 0.995:
        up_hint = np.array([0.0, 1.0, 0.0], dtype=np.float64)

    right = np.cross(forward, up_hint)
    right /= np.linalg.norm(right) + 1e-12
    up = np.cross(right, forward)
    up /= np.linalg.norm(up) + 1e-12

    sensor_h_mm = float(sensor_width_mm) * (float(resolution_y) / float(resolution_x))
    fov_h = 2.0 * math.atan((float(sensor_width_mm) * 0.5) / float(lens_mm))
    fov_v = 2.0 * math.atan((sensor_h_mm * 0.5) / float(lens_mm))
    tan_h = max(math.tan(fov_h * 0.5), 1e-8)
    tan_v = max(math.tan(fov_v * 0.5), 1e-8)

    delta = pts - tgt[None, :]
    x = delta @ right
    y = delta @ up
    a = delta @ camera_dir

    r_min_front = float(np.max(a) + 1e-4)
    r_min_h = float(np.max(a + np.abs(x) / (occupancy * tan_h)))
    r_min_v = float(np.max(a + np.abs(y) / (occupancy * tan_v)))
    return max(r_min_front, r_min_h, r_min_v)


def required_camera_radius_for_points_multi_azimuth(points_world, target_world, azimuths_deg, elevation_deg, occupancy):
    radii = []
    for azimuth in azimuths_deg:
        radii.append(
            required_camera_radius_for_points(
                points_world=points_world,
                target_world=target_world,
                azimuth_deg=float(azimuth),
                elevation_deg=float(elevation_deg),
                occupancy=float(occupancy),
            )
        )
    if not radii:
        raise ValueError("azimuths_deg is empty")
    return float(max(radii))


def cleanup_mesh(obj, merge_distance=1e-5):
    """Post-import cleanup: merge duplicate verts at seams + recompute outward normals.
    Without this, OBJs exported with split vertices (UV seams, material seams) render
    with visible cracks/seams and inconsistent shading. Run before any other op needs valid topology.
    """
    if obj.type != "MESH" or obj.data is None or len(obj.data.vertices) == 0:
        return
    bpy.ops.object.select_all(action="DESELECT")
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.mode_set(mode="EDIT")
    bpy.ops.mesh.select_all(action="SELECT")
    bpy.ops.mesh.remove_doubles(threshold=float(merge_distance))
    bpy.ops.mesh.normals_make_consistent(inside=False)
    bpy.ops.object.mode_set(mode="OBJECT")


def ensure_materials(objects):
    for obj in objects:
        if obj.type != "MESH":
            continue
        if not obj.material_slots:
            mat = bpy.data.materials.new(name=f"AutoMat_{obj.name}")
            mat.use_nodes = True
            obj.data.materials.append(mat)
        for slot in obj.material_slots:
            if slot.material is None:
                slot.material = bpy.data.materials.new(name=f"AutoMat_{obj.name}")
                slot.material.use_nodes = True


def import_part_meshes(part_meshes_info):
    """Import per-part OBJ files; assign material pass_index = part_id + 1."""
    all_objects = []
    for part in sorted(part_meshes_info, key=lambda p: p["part_id"]):
        part_id = int(part["part_id"])
        obj_path = Path(part["obj_path"])
        pass_idx = part_id + 1

        if not obj_path.exists():
            raise RuntimeError(f"Part mesh not found: {obj_path}")

        before = {o.name_full for o in bpy.context.scene.objects}
        bpy.ops.wm.obj_import(filepath=obj_path.as_posix())
        imported = [
            o
            for o in bpy.context.scene.objects
            if o.name_full not in before and o.type == "MESH"
        ]

        if not imported:
            print(f"[WARN] No mesh objects from {obj_path}")
            continue

        for obj in imported:
            cleanup_mesh(obj)

        ensure_materials(imported)
        for obj in imported:
            for slot in obj.material_slots:
                if slot.material is None:
                    continue
                slot.material = slot.material.copy()
                slot.material.pass_index = pass_idx

        all_objects.extend(imported)

    if not all_objects:
        raise RuntimeError("No mesh objects imported from any part mesh")
    return all_objects


def stabilize_materials(objects):
    for obj in objects:
        for slot in obj.material_slots:
            mat = slot.material
            if mat is None:
                continue
            mat.use_nodes = True
            node_tree = mat.node_tree
            if node_tree is None:
                continue

            principled = None
            for node in node_tree.nodes:
                if node.bl_idname == "ShaderNodeBsdfPrincipled":
                    principled = node
                    break

            if principled is None:
                continue

            alpha = principled.inputs.get("Alpha")
            if alpha is not None and not alpha.is_linked and float(alpha.default_value) >= 0.999:
                mat.blend_method = "OPAQUE"
                if hasattr(mat, "shadow_method"):
                    mat.shadow_method = "OPAQUE"


def sample_object_vertices(obj, max_points=2048):
    mesh = obj.data
    if mesh is None or len(mesh.vertices) == 0:
        return np.zeros((0, 3), dtype=np.float64)
    verts = np.array([tuple(obj.matrix_world @ vertex.co) for vertex in mesh.vertices], dtype=np.float64)
    if len(verts) <= max_points:
        return verts
    index = np.linspace(0, len(verts) - 1, int(max_points), dtype=np.int64)
    return verts[index]


def object_bbox_corners(obj):
    corners = [obj.matrix_world @ Vector(corner) for corner in obj.bound_box]
    return np.array([tuple(corner) for corner in corners], dtype=np.float64)


def compute_static_norm(objects):
    mins = []
    maxs = []
    fit_point_chunks = []
    for obj in objects:
        bbox = object_bbox_corners(obj)
        mins.append(bbox.min(axis=0))
        maxs.append(bbox.max(axis=0))
        verts = sample_object_vertices(obj, max_points=2048)
        if len(verts) > 0:
            fit_point_chunks.append(verts)

    global_min = np.min(np.vstack(mins), axis=0)
    global_max = np.max(np.vstack(maxs), axis=0)
    ranges = global_max - global_min
    max_range = max(float(ranges[0]), float(ranges[1]), float(ranges[2]), 1e-8)
    scale = 1.0 / max_range

    center = 0.5 * (global_min + global_max)
    translation = (-scale * center[0], -scale * center[1], -scale * center[2])
    return scale, translation, fit_point_chunks


def apply_static_norm(objects, scale, translation):
    for obj in objects:
        obj.scale *= float(scale)
        obj.location += Vector((translation[0], translation[1], translation[2]))

    bpy.ops.object.select_all(action="DESELECT")
    for obj in objects:
        obj.select_set(True)
    bpy.context.view_layer.objects.active = objects[0]
    bpy.ops.object.transform_apply(location=True, rotation=False, scale=True)


def collect_world_fit_points(objects):
    chunks = []
    for obj in objects:
        verts = sample_object_vertices(obj, max_points=2048)
        if len(verts) > 0:
            chunks.append(verts)
    if not chunks:
        raise RuntimeError("No geometry available after normalization")
    points = np.concatenate(chunks, axis=0)
    if len(points) > 30000:
        index = np.linspace(0, len(points) - 1, 30000, dtype=np.int64)
        points = points[index]
    return points


def configure_world(world):
    world.use_nodes = True
    node_tree = world.node_tree
    node_tree.nodes.clear()

    out = node_tree.nodes.new("ShaderNodeOutputWorld")
    bg = node_tree.nodes.new("ShaderNodeBackground")
    coord = node_tree.nodes.new("ShaderNodeTexCoord")
    mapping = node_tree.nodes.new("ShaderNodeMapping")
    grad = node_tree.nodes.new("ShaderNodeTexGradient")
    ramp = node_tree.nodes.new("ShaderNodeValToRGB")

    grad.gradient_type = "LINEAR"
    ramp.color_ramp.interpolation = "EASE"
    while len(ramp.color_ramp.elements) > 2:
        ramp.color_ramp.elements.remove(ramp.color_ramp.elements[-1])

    ramp.color_ramp.elements[0].position = 0.0
    ramp.color_ramp.elements[0].color = (0.74, 0.74, 0.74, 1.0)
    ramp.color_ramp.elements[1].position = 0.35
    ramp.color_ramp.elements[1].color = (0.90, 0.90, 0.90, 1.0)
    elem = ramp.color_ramp.elements.new(1.0)
    elem.position = 1.0
    elem.color = (0.98, 0.98, 0.98, 1.0)

    bg.inputs["Strength"].default_value = 0.40

    node_tree.links.new(coord.outputs["Generated"], mapping.inputs["Vector"])
    node_tree.links.new(mapping.outputs["Vector"], grad.inputs["Vector"])
    node_tree.links.new(grad.outputs["Fac"], ramp.inputs["Fac"])
    node_tree.links.new(ramp.outputs["Color"], bg.inputs["Color"])
    node_tree.links.new(bg.outputs["Background"], out.inputs["Surface"])


def setup_scene(camera_r):
    scene = bpy.context.scene
    scene.render.film_transparent = True

    world = scene.world
    if world is None:
        world = bpy.data.worlds.new("World")
        scene.world = world
    configure_world(world)

    def add_area_light(name, location, rotation, energy, size, use_shadow=True):
        bpy.ops.object.light_add(type="AREA", location=location, rotation=rotation)
        obj = bpy.context.active_object
        obj.name = name
        obj.data.energy = energy
        obj.data.size = size
        obj.data.use_shadow = use_shadow
        return obj

    add_area_light(
        "KeyFront",
        location=(2.6, -2.2, 3.8),
        rotation=(math.radians(58.0), 0.0, math.radians(32.0)),
        energy=172,
        size=4.8,
    )
    add_area_light(
        "FillBackLeft",
        location=(-2.8, 1.8, 2.8),
        rotation=(math.radians(55.0), 0.0, math.radians(-140.0)),
        energy=92,
        size=6.4,
    )
    add_area_light(
        "TopBack",
        location=(0.0, 2.4, 4.6),
        rotation=(math.radians(150.0), 0.0, math.radians(180.0)),
        energy=58,
        size=5.2,
    )
    bpy.ops.object.light_add(
        type="SUN",
        location=(0.0, 0.0, 0.0),
        rotation=(math.radians(52.0), 0.0, math.radians(28.0)),
    )
    sun = bpy.context.active_object
    sun.name = "SunKey"
    sun.data.energy = 2.2
    sun.data.angle = 0.14

    bpy.ops.object.camera_add()
    cam = bpy.context.active_object
    scene.camera = cam
    cam.data.lens = lens_mm
    cam.data.sensor_width = sensor_width_mm
    cam.data.type = "PERSP"

    bpy.ops.object.light_add(type="AREA", location=(0.0, 0.0, 0.0))
    cam_fill = bpy.context.active_object
    cam_fill.name = "CameraFill"
    cam_fill.parent = cam
    cam_fill.location = Vector((0.0, 0.0, 0.0))
    cam_fill.data.energy = 60
    cam_fill.data.size = 5.5
    cam_fill.data.use_shadow = False

    scene.render.engine = "CYCLES"
    scene.render.resolution_x = resolution_x
    scene.render.resolution_y = resolution_y
    scene.render.resolution_percentage = resolution_percentage

    scene.view_settings.view_transform = "AgX"
    scene.view_settings.look = "AgX - Base Contrast"
    scene.view_settings.exposure = 0.08

    try:
        prefs = bpy.context.preferences.addons["cycles"].preferences
        # ARTIBENCH_BLENDER_DEVICE lets a host force CPU rendering. Some nodes
        # stall for minutes in Cycles GPU init on every invocation, never
        # writing a kernel cache; CPU is far faster there for scenes this
        # small. Unset/GPU keeps the CUDA path.
        import os as _os
        if _os.environ.get("ARTIBENCH_BLENDER_DEVICE", "").upper() == "CPU":
            scene.cycles.device = "CPU"
        else:
            prefs.compute_device_type = "CUDA"
            scene.cycles.device = "GPU"
            prefs.get_devices()
    except Exception:
        scene.cycles.device = "CPU"

    scene.cycles.samples = 192
    scene.cycles.use_denoising = True
    return cam


def render_rgb(rgb_path):
    scene = bpy.context.scene
    scene.render.image_settings.color_mode = "RGBA"
    scene.render.image_settings.file_format = "PNG"
    scene.render.filepath = rgb_path
    bpy.ops.render.render(write_still=True)


def _create_normal_material():
    """Create a material that emits world-space normals as color."""
    mat = bpy.data.materials.new(name="_NormalOverride")
    mat.use_nodes = True
    nt = mat.node_tree
    nt.nodes.clear()

    out = nt.nodes.new("ShaderNodeOutputMaterial")
    emit = nt.nodes.new("ShaderNodeEmission")
    geom = nt.nodes.new("ShaderNodeNewGeometry")
    map_range = nt.nodes.new("ShaderNodeMapRange")

    # Map Normal from [-1, 1] to [0, 1] for each component
    map_range.data_type = "FLOAT_VECTOR"
    map_range.inputs[7].default_value = (-1.0, -1.0, -1.0)   # From Min
    map_range.inputs[8].default_value = (1.0, 1.0, 1.0)       # From Max
    map_range.inputs[9].default_value = (0.0, 0.0, 0.0)       # To Min
    map_range.inputs[10].default_value = (1.0, 1.0, 1.0)      # To Max

    nt.links.new(geom.outputs["Normal"], map_range.inputs[6])  # Vector input
    nt.links.new(map_range.outputs[1], emit.inputs["Color"])   # Vector output
    emit.inputs["Strength"].default_value = 1.0
    nt.links.new(emit.outputs["Emission"], out.inputs["Surface"])

    return mat


def _override_materials_for_normal(objects):
    """Replace all materials with the normal-map material; return backup."""
    normal_mat = _create_normal_material()
    backup = {}
    for obj in objects:
        if obj.type != "MESH":
            continue
        slot_mats = []
        for slot in obj.material_slots:
            slot_mats.append(slot.material)
            slot.material = normal_mat
        backup[obj.name_full] = slot_mats
    return backup


def _restore_materials(objects, backup):
    """Restore original materials from backup."""
    for obj in objects:
        if obj.name_full not in backup:
            continue
        for slot, orig_mat in zip(obj.material_slots, backup[obj.name_full]):
            slot.material = orig_mat


def render_normal(normal_path, objects):
    """Render a normal-map image: override materials, disable lighting, render, restore."""
    scene = bpy.context.scene

    # Save and override scene settings for flat emission rendering
    old_film_transparent = scene.render.film_transparent
    old_samples = scene.cycles.samples
    scene.render.film_transparent = True
    scene.cycles.samples = 1  # normals don't need many samples

    # Disable view transform (we want raw values)
    old_view_transform = scene.view_settings.view_transform
    old_look = scene.view_settings.look
    old_exposure = scene.view_settings.exposure
    scene.view_settings.view_transform = "Raw"
    scene.view_settings.look = "None"
    scene.view_settings.exposure = 0.0

    backup = _override_materials_for_normal(objects)

    scene.render.image_settings.color_mode = "RGBA"
    scene.render.image_settings.file_format = "PNG"
    scene.render.filepath = normal_path
    bpy.ops.render.render(write_still=True)

    _restore_materials(objects, backup)

    # Restore scene settings
    scene.render.film_transparent = old_film_transparent
    scene.cycles.samples = old_samples
    scene.view_settings.view_transform = old_view_transform
    scene.view_settings.look = old_look
    scene.view_settings.exposure = old_exposure


def render_mask(mask_dir, mask_basename):
    scene = bpy.context.scene
    scene.use_nodes = True
    bpy.context.view_layer.use_pass_material_index = True

    nt = scene.node_tree
    nt.nodes.clear()

    rl = nt.nodes.new("CompositorNodeRLayers")
    out_mask = nt.nodes.new("CompositorNodeOutputFile")
    out_mask.base_path = mask_dir
    out_mask.file_slots[0].use_node_format = True
    out_mask.format.file_format = "OPEN_EXR"
    out_mask.file_slots[0].path = mask_basename
    nt.links.new(rl.outputs["IndexMA"], out_mask.inputs[0])

    bpy.ops.render.render(write_still=True)

    # Disable compositor so subsequent RGB renders are not affected.
    scene.use_nodes = False

    mask_pattern = os.path.join(mask_dir, f"{mask_basename}*.exr")
    mask_candidates = sorted(glob.glob(mask_pattern), key=os.path.getmtime, reverse=True)
    return mask_candidates[0] if mask_candidates else None


def save_mask_npy(mask_exr_path, mask_npy_out):
    if not mask_npy_out or not mask_exr_path or not os.path.exists(mask_exr_path):
        return

    img = bpy.data.images.load(mask_exr_path)
    width, height = img.size
    buffer = np.array(img.pixels[:], dtype=np.float32)
    if buffer.size < width * height:
        return

    if buffer.size == width * height:
        arr = buffer.reshape((height, width))
    else:
        arr = buffer.reshape((height, width, -1))[:, :, 0]

    labels = np.rint(arr).astype(np.int32)
    labels = np.flipud(labels)
    labels[labels < 0] = 0
    np.save(mask_npy_out, labels)

    try:
        os.remove(mask_exr_path)
    except Exception:
        pass


def main():
    clear_scene()

    with manifest_path.open("r", encoding="utf-8") as handle:
        manifest = json.load(handle)

    part_meshes_info = manifest.get("part_meshes", [])
    if not part_meshes_info:
        raise RuntimeError("No part_meshes in render manifest")

    mesh_objs = import_part_meshes(part_meshes_info)
    stabilize_materials(mesh_objs)

    scale, translation, _ = compute_static_norm(mesh_objs)
    apply_static_norm(mesh_objs, scale, translation)
    fit_points = collect_world_fit_points(mesh_objs)

    frames = manifest.get("frames", [])
    azimuths = [float(frame["azimuth_deg"]) for frame in frames]
    if not azimuths:
        raise RuntimeError("No frames in render manifest")

    occupancy, zoom = split_fit_margin(fit_margin)
    if camera_r_override is None:
        resolved_r = required_camera_radius_for_points_multi_azimuth(
            points_world=fit_points,
            target_world=np.array([0.0, 0.0, target_z], dtype=np.float64),
            azimuths_deg=azimuths,
            elevation_deg=float(camera_elevation),
            occupancy=float(occupancy),
        )
        resolved_r = float(resolved_r / zoom)
    else:
        resolved_r = float(camera_r_override)

    state_path.write_text(
        json.dumps(
            {
                "scale": float(scale),
                "translation": [float(v) for v in translation],
                "camera_r": float(resolved_r),
            },
            indent=2,
        ),
        encoding="utf-8",
    )

    render_masks = manifest.get("render_masks", False)
    render_normals = manifest.get("render_normals", False)
    cam = setup_scene(resolved_r)
    target = Vector((0.0, 0.0, target_z))

    for frame in frames:
        azimuth = float(frame["azimuth_deg"])
        rgb_path = frame["rgb_path"]

        cam.location = Vector(spherical_to_cartesian(resolved_r, azimuth, camera_elevation))
        direction = target - cam.location
        cam.rotation_euler = direction.to_track_quat("-Z", "Y").to_euler()

        os.makedirs(os.path.dirname(rgb_path), exist_ok=True)
        render_rgb(rgb_path)

        if render_normals:
            normal_path = frame.get("normal_path")
            if normal_path:
                os.makedirs(os.path.dirname(normal_path), exist_ok=True)
                render_normal(normal_path, mesh_objs)

        if render_masks:
            mask_npy = frame["mask_npy_path"]
            mask_tmp = frame["mask_tmp_base"]
            mask_dir = os.path.dirname(mask_tmp)
            mask_base = os.path.basename(mask_tmp)
            os.makedirs(mask_dir, exist_ok=True)
            mask_exr_path = render_mask(mask_dir, mask_base)
            save_mask_npy(mask_exr_path, mask_npy)


def _entry():
    try:
        main()
    except Exception as exc:
        print(f"[blender_render_mesh_custom_infer] failed: {exc}")
        raise


if __name__ == "__main__":
    _entry()
