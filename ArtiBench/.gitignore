# Python
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.venv/
venv/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.vscode/
